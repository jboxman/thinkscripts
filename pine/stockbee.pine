min_30 := (close[30] < min_30) ? close[30] : min_30

max_30 := (close[2] > max_30) ? close[2] : max_30
max_30 := (close[3] > max_30) ? close[3] : max_30
max_30 := (close[4] > max_30) ? close[4] : max_30
max_30 := (close[5] > max_30) ? close[5] : max_30
