max_30 := (close[18] > max_30) ? close[18] : max_30
max_30 := (close[19] > max_30) ? close[19] : max_30
max_30 := (close[20] > max_30) ? close[20] : max_30
max_30 := (close[21] > max_30) ? close[21] : max_30
max_30 := (close[22] > max_30) ? close[22] : max_30
max_30 := (close[23] > max_30) ? close[23] : max_30
max_30 := (close[24] > max_30) ? close[24] : max_30
max_30 := (close[25] > max_30) ? close[25] : max_30
max_30 := (close[26] > max_30) ? close[26] : max_30
max_30 := (close[27] > max_30) ? close[27] : max_30
max_30 := (close[28] > max_30) ? close[28] : max_30
max_30 := (close[29] > max_30) ? close[29] : max_30
max_30 := (close[30] > max_30) ? close[30] : max_30

// 3) Volume Filter
min_vol := (volume[1] < volume[2]) ? volume[1] : volume[2]
min_vol := (min_vol < volume[3]) ? min_vol : volume[3]

// 4) Logic
bool isBullish = ((close / min_30 >= 1.20) or (close - min_30 >= 20.0)) and (close >= 3.0) and (min_vol >= 100000.0)
bool isBearish = ((close / max_30 <= 0.80) or (max_30 - close >= 20.0)) and (close >= 5.0) and (min_vol >= 100000.0)

// 5) Define Positions (Bullish at bottom, Bearish at top)
float plotBull = isBullish ? 80.0 : 0.0
float plotBear = isBearish ? 120.0 : 200.0


// Plot the lines
pBull = plt(plotBull, name=" ", color=color.green, type=plt.type_line, line_width=2)
pBear = plt(plotBear, name=" ", color=color.red, type=plt.type_line, line_width=2)

// Baselines
pBaseLow  = plt(0.0, name=" ", color=color.gray, opacity=0, type=plt.type_line, line_width=1)
pBaseHigh = plt(200.0, name=" ", color=color.gray, opacity=0, type=plt.type_line, line_width=1)

// Fill logic (Bullish up from bottom, Bearish down from top)
plt.fill_between(pBull, pBaseLow, color.green, opacity=50, name=" ")
plt.fill_between(pBear, pBaseHigh, color.red, opacity=50, name=" ")

