// TI-65

fRaw = ind.sma(close, 7)
sRaw = ind.sma(close, 65)
tiValue = (100 * (fill_none(fRaw) / fill_none(sRaw))) - 100 


isBullish = (tiValue >= 5.0)
plotBull = isBullish ? 100.0 : 0.0


isBearish = (tiValue <= -5.0)
plotBear = isBearish ? 100.0 : 0.0


pBull = plt(plotBull, name="65", color=color.lime, type=plt.type_line, line_width=1)
pBear = plt(plotBear, name="65", color=color.red, type=plt.type_line, line_width=1)
pBase = plt(0.0, name="Baseline", color=color.gray, opacity=0, type=plt.type_line, line_width=1)


plt.fill_between(pBull, pBase, color.lime, opacity=30, name="65")
plt.fill_between(pBear, pBase, color.red, opacity=30, name="65")

---

// EP9

// Stockbee Momentum Indicator - Final Configuration
// Lines (100k Vol): Shaded with fill
// Histograms (9M Vol): Solid bars, no fill

// --- Declarations ---
float c1 = close[1]
float v1 = volume[1]
float min_vol_line = 100000   // 100k for Lines
float min_vol_ep9  = 9000000  // 9M for Histograms

// --- Calculation Logic ---

// Bullish Logic
float bull_4pct_line = ((close / c1) >= 1.04) and (volume > v1) and (volume >= min_vol_line) ? 100.0 : 0.0
float bull_ep9_hist  = ((close / c1) >= 1.04) and (volume > v1) and (volume >= min_vol_ep9) ? 90.0 : 0.0

// Bearish Logic
float bear_4pct_line = ((close / c1) <= 0.96) and (volume > v1) and (volume >= min_vol_line) ? 100.0 : 0.0
float bear_ep9_hist  = ((close / c1) <= 0.96) and (volume > v1) and (volume >= min_vol_ep9) ? 70.0 : 0.0

// --- Plotting ---

// 1. Momentum Lines (4% / 100k) - Assigned to variables for fill
pBull = plt(bull_4pct_line, name=" ", color=color.green, type=plt.type_line, line_width=2)
pBear = plt(bear_4pct_line, name=" ", color=color.red, type=plt.type_line, line_width=2)


// 3. Baseline for Fill (Invisible)
pBase = plt(0.0, name="Baseline", color=color.gray, opacity=0, type=plt.type_line, line_width=1)

// 4. Fill Application (ONLY applied to the lines)
plt.fill_between(pBull, pBase, color.green, opacity=10, name=" ")
plt.fill_between(pBear, pBase, color.red, opacity=10, name=" ")

// 2. EP9 Histograms (4% / 9M)
plt(bull_ep9_hist, name=" ", color=color.black, type=plt.type_histogram, opacity=100, line_width=5)
plt(bear_ep9_hist, name=" ", color=color.red, type=plt.type_histogram, opacity=100, line_width=5)

---

