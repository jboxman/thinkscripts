max_30 := (close[9] > max_30) ? close[9] : max_30
max_30 := (close[10] > max_30) ? close[10] : max_30
max_30 := (close[11] > max_30) ? close[11] : max_30
max_30 := (close[12] > max_30) ? close[12] : max_30
max_30 := (close[13] > max_30) ? close[13] : max_30
max_30 := (close[14] > max_30) ? close[14] : max_30
max_30 := (close[15] > max_30) ? close[15] : max_30
max_30 := (close[16] > max_30) ? close[16] : max_30
