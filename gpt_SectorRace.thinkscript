declare lower;

input benchmark = "SPX";
input intradayLookbackBars = 63;
input dailyLookbackBars = 63;
input weeklyLookbackBars = 26;
input monthlyLookbackBars = 12;
input showOnlyPositive = yes;
input showBubbles = no;

DefineGlobalColor("Materials", CreateColor(255, 140, 0));
DefineGlobalColor("Industrials", CreateColor(255, 215, 0));
DefineGlobalColor("ConsumerDiscretionary", CreateColor(255, 0, 255));
DefineGlobalColor("ConsumerStaples", CreateColor(50, 205, 50));
DefineGlobalColor("HealthCare", CreateColor(186, 85, 211));
DefineGlobalColor("Financials", CreateColor(0, 191, 255));
DefineGlobalColor("InformationTechnology", CreateColor(0, 120, 255));
DefineGlobalColor("CommunicationServices", CreateColor(211, 211, 211));
DefineGlobalColor("RealEstate", CreateColor(255, 105, 180));

script RelPerf {
  input symbol = "$SP500#10";
  input benchmark = "SPX";
  input lookbackBars = 63;
  input showOnlyPositive = no;

  def c = close(symbol = symbol);
  def b = close(symbol = benchmark);

  def groupReturn = c / c[lookbackBars] - 1;
  def benchReturn = b / b[lookbackBars] - 1;
  def rs = 100 * (groupReturn - benchReturn);

  plot value =
    if showOnlyPositive and rs <= 0 then
      Double.NaN
    else
      rs;
}

# Deduped from the provided list: 10, 15, 20, 25, 30, 35, 40, 45, 50, 55, 60.
def aggregationPeriod = GetAggregationPeriod();
def lookbackBars =
  if aggregationPeriod >= AggregationPeriod.MONTH then
    monthlyLookbackBars
  else if aggregationPeriod >= AggregationPeriod.WEEK then
    weeklyLookbackBars
  else if aggregationPeriod >= AggregationPeriod.DAY then
    dailyLookbackBars
  else
    intradayLookbackBars;

plot Baseline = 0;
Baseline.SetDefaultColor(Color.GRAY);
Baseline.SetStyle(Curve.SHORT_DASH);

def EnergyValue = RelPerf("$SP500#10", benchmark, lookbackBars, no);
def MaterialsValue = RelPerf("$SP500#15", benchmark, lookbackBars, no);
def IndustrialsValue = RelPerf("$SP500#20", benchmark, lookbackBars, no);
def ConsumerDiscretionaryValue = RelPerf("$SP500#25", benchmark, lookbackBars, no);
def ConsumerStaplesValue = RelPerf("$SP500#30", benchmark, lookbackBars, no);
def HealthCareValue = RelPerf("$SP500#35", benchmark, lookbackBars, no);
def FinancialsValue = RelPerf("$SP500#40", benchmark, lookbackBars, no);
def InformationTechnologyValue = RelPerf("$SP500#45", benchmark, lookbackBars, no);
def CommunicationServicesValue = RelPerf("$SP500#50", benchmark, lookbackBars, no);
def UtilitiesValue = RelPerf("$SP500#55", benchmark, lookbackBars, no);
def RealEstateValue = RelPerf("$SP500#60", benchmark, lookbackBars, no);

plot Energy = RelPerf("$SP500#10", benchmark, lookbackBars, showOnlyPositive);
plot Materials = RelPerf("$SP500#15", benchmark, lookbackBars, showOnlyPositive);
plot Industrials = RelPerf("$SP500#20", benchmark, lookbackBars, showOnlyPositive);
plot ConsumerDiscretionary = RelPerf("$SP500#25", benchmark, lookbackBars, showOnlyPositive);
plot ConsumerStaples = RelPerf("$SP500#30", benchmark, lookbackBars, showOnlyPositive);
plot HealthCare = RelPerf("$SP500#35", benchmark, lookbackBars, showOnlyPositive);
plot Financials = RelPerf("$SP500#40", benchmark, lookbackBars, showOnlyPositive);
plot InformationTechnology = RelPerf("$SP500#45", benchmark, lookbackBars, showOnlyPositive);
plot CommunicationServices = RelPerf("$SP500#50", benchmark, lookbackBars, showOnlyPositive);
plot Utilities = RelPerf("$SP500#55", benchmark, lookbackBars, showOnlyPositive);
plot RealEstate = RelPerf("$SP500#60", benchmark, lookbackBars, showOnlyPositive);

Energy.SetDefaultColor(Color.RED);
Materials.SetDefaultColor(GlobalColor("Materials"));
Industrials.SetDefaultColor(GlobalColor("Industrials"));
ConsumerDiscretionary.SetDefaultColor(GlobalColor("ConsumerDiscretionary"));
ConsumerStaples.SetDefaultColor(GlobalColor("ConsumerStaples"));
HealthCare.SetDefaultColor(GlobalColor("HealthCare"));
Financials.SetDefaultColor(GlobalColor("Financials"));
InformationTechnology.SetDefaultColor(GlobalColor("InformationTechnology"));
CommunicationServices.SetDefaultColor(GlobalColor("CommunicationServices"));
Utilities.SetDefaultColor(Color.GREEN);
RealEstate.SetDefaultColor(GlobalColor("RealEstate"));

AddLabel(yes, "EN Energy " + AsText(Round(EnergyValue, 1)), Color.RED);
AddLabel(yes, "MAT Materials " + AsText(Round(MaterialsValue, 1)), GlobalColor("Materials"));
AddLabel(yes, "IND Industrials " + AsText(Round(IndustrialsValue, 1)), GlobalColor("Industrials"));
AddLabel(yes, "CD Consumer disc " + AsText(Round(ConsumerDiscretionaryValue, 1)), GlobalColor("ConsumerDiscretionary"));
AddLabel(yes, "CS Consumer staples " + AsText(Round(ConsumerStaplesValue, 1)), GlobalColor("ConsumerStaples"));
AddLabel(yes, "HC Health care " + AsText(Round(HealthCareValue, 1)), GlobalColor("HealthCare"));
AddLabel(yes, "FIN Financials " + AsText(Round(FinancialsValue, 1)), GlobalColor("Financials"));
AddLabel(yes, "IT Info tech " + AsText(Round(InformationTechnologyValue, 1)), GlobalColor("InformationTechnology"));
AddLabel(yes, "COM Comm svcs " + AsText(Round(CommunicationServicesValue, 1)), GlobalColor("CommunicationServices"));
AddLabel(yes, "UTIL Utilities " + AsText(Round(UtilitiesValue, 1)), Color.GREEN);
AddLabel(yes, "RE Real estate " + AsText(Round(RealEstateValue, 1)), GlobalColor("RealEstate"));

def lastBar = !IsNaN(close) and IsNaN(close[-1]);

AddChartBubble(showBubbles and lastBar and EnergyValue > 0, EnergyValue, "EN Energy " + AsText(Round(EnergyValue, 1)), Color.RED, yes);
AddChartBubble(showBubbles and lastBar and MaterialsValue > 0, MaterialsValue, "MAT Materials " + AsText(Round(MaterialsValue, 1)), GlobalColor("Materials"), yes);
AddChartBubble(showBubbles and lastBar and IndustrialsValue > 0, IndustrialsValue, "IND Industrials " + AsText(Round(IndustrialsValue, 1)), GlobalColor("Industrials"), yes);
AddChartBubble(showBubbles and lastBar and ConsumerDiscretionaryValue > 0, ConsumerDiscretionaryValue, "CD Consumer disc " + AsText(Round(ConsumerDiscretionaryValue, 1)), GlobalColor("ConsumerDiscretionary"), yes);
AddChartBubble(showBubbles and lastBar and ConsumerStaplesValue > 0, ConsumerStaplesValue, "CS Consumer staples " + AsText(Round(ConsumerStaplesValue, 1)), GlobalColor("ConsumerStaples"), yes);
AddChartBubble(showBubbles and lastBar and HealthCareValue > 0, HealthCareValue, "HC Health care " + AsText(Round(HealthCareValue, 1)), GlobalColor("HealthCare"), yes);
AddChartBubble(showBubbles and lastBar and FinancialsValue > 0, FinancialsValue, "FIN Financials " + AsText(Round(FinancialsValue, 1)), GlobalColor("Financials"), yes);
AddChartBubble(showBubbles and lastBar and InformationTechnologyValue > 0, InformationTechnologyValue, "IT Info tech " + AsText(Round(InformationTechnologyValue, 1)), GlobalColor("InformationTechnology"), yes);
AddChartBubble(showBubbles and lastBar and CommunicationServicesValue > 0, CommunicationServicesValue, "COM Comm svcs " + AsText(Round(CommunicationServicesValue, 1)), GlobalColor("CommunicationServices"), yes);
AddChartBubble(showBubbles and lastBar and UtilitiesValue > 0, UtilitiesValue, "UTIL Utilities " + AsText(Round(UtilitiesValue, 1)), Color.GREEN, yes);
AddChartBubble(showBubbles and lastBar and RealEstateValue > 0, RealEstateValue, "RE Real estate " + AsText(Round(RealEstateValue, 1)), GlobalColor("RealEstate"), yes);
