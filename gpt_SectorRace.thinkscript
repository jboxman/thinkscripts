declare lower;

input benchmark = "SPX";
input intradayLookbackBars = 63;
input dailyLookbackBars = 63;
input weeklyLookbackBars = 26;
input monthlyLookbackBars = 12;
input showOnlyPositive = no;
input showLabels = yes;
input showBubbles = yes;

DefineGlobalColor("Materials", CreateColor(255, 140, 0));
DefineGlobalColor("Industrials", CreateColor(255, 215, 0));
DefineGlobalColor("ConsumerDisc", CreateColor(255, 0, 255));
DefineGlobalColor("ConsumerStaples", CreateColor(50, 205, 50));
DefineGlobalColor("HealthCare", CreateColor(186, 85, 211));
DefineGlobalColor("Financials", CreateColor(0, 191, 255));
DefineGlobalColor("Tech", CreateColor(0, 120, 255));
DefineGlobalColor("CommServices", CreateColor(211, 211, 211));
DefineGlobalColor("RealEstate", CreateColor(255, 105, 180));

script RelPerf {
  input symbol = "$SP500#10";
  input benchmark = "SPX";
  input lookbackBars = 63;
  input showOnlyPositive = no;

  def c = close(symbol = symbol);
  def b = close(symbol = benchmark);

  def groupReturn = c / c[lookbackBars] - 1;
  def benchReturn = b / b[lookbackBars] - 1;
  def rs = 100 * (groupReturn - benchReturn);

  plot value =
    if showOnlyPositive and rs <= 0 then
      Double.NaN
    else
      rs;
}

# Deduped from the provided list: 10, 15, 20, 25, 30, 35, 40, 45, 50, 55, 60.
def aggregationPeriod = GetAggregationPeriod();
def lookbackBars =
  if aggregationPeriod >= AggregationPeriod.MONTH then
    monthlyLookbackBars
  else if aggregationPeriod >= AggregationPeriod.WEEK then
    weeklyLookbackBars
  else if aggregationPeriod >= AggregationPeriod.DAY then
    dailyLookbackBars
  else
    intradayLookbackBars;

plot Baseline = 0;
Baseline.SetDefaultColor(Color.GRAY);
Baseline.SetStyle(Curve.SHORT_DASH);

plot Energy = RelPerf("$SP500#10", benchmark, lookbackBars, showOnlyPositive);
plot Materials = RelPerf("$SP500#15", benchmark, lookbackBars, showOnlyPositive);
plot Industrials = RelPerf("$SP500#20", benchmark, lookbackBars, showOnlyPositive);
plot ConsumerDiscretionary = RelPerf("$SP500#25", benchmark, lookbackBars, showOnlyPositive);
plot ConsumerStaples = RelPerf("$SP500#30", benchmark, lookbackBars, showOnlyPositive);
plot HealthCare = RelPerf("$SP500#35", benchmark, lookbackBars, showOnlyPositive);
plot Financials = RelPerf("$SP500#40", benchmark, lookbackBars, showOnlyPositive);
plot InformationTechnology = RelPerf("$SP500#45", benchmark, lookbackBars, showOnlyPositive);
plot CommunicationServices = RelPerf("$SP500#50", benchmark, lookbackBars, showOnlyPositive);
plot Utilities = RelPerf("$SP500#55", benchmark, lookbackBars, showOnlyPositive);
plot RealEstate = RelPerf("$SP500#60", benchmark, lookbackBars, showOnlyPositive);

Energy.SetDefaultColor(Color.RED);
Materials.SetDefaultColor(GlobalColor("Materials"));
Industrials.SetDefaultColor(GlobalColor("Industrials"));
ConsumerDiscretionary.SetDefaultColor(GlobalColor("ConsumerDisc"));
ConsumerStaples.SetDefaultColor(GlobalColor("ConsumerStaples"));
HealthCare.SetDefaultColor(GlobalColor("HealthCare"));
Financials.SetDefaultColor(GlobalColor("Financials"));
InformationTechnology.SetDefaultColor(GlobalColor("Tech"));
CommunicationServices.SetDefaultColor(GlobalColor("CommServices"));
Utilities.SetDefaultColor(Color.GREEN);
RealEstate.SetDefaultColor(GlobalColor("RealEstate"));

AddLabel(showLabels and !IsNaN(Energy), "Energy " + AsText(Round(Energy, 1)), Color.RED);
AddLabel(showLabels and !IsNaN(Materials), "Materials " + AsText(Round(Materials, 1)), GlobalColor("Materials"));
AddLabel(showLabels and !IsNaN(Industrials), "Industrials " + AsText(Round(Industrials, 1)), GlobalColor("Industrials"));
AddLabel(showLabels and !IsNaN(ConsumerDiscretionary), "Consumer disc " + AsText(Round(ConsumerDiscretionary, 1)), GlobalColor("ConsumerDisc"));
AddLabel(showLabels and !IsNaN(ConsumerStaples), "Consumer staples " + AsText(Round(ConsumerStaples, 1)), GlobalColor("ConsumerStaples"));
AddLabel(showLabels and !IsNaN(HealthCare), "Health care " + AsText(Round(HealthCare, 1)), GlobalColor("HealthCare"));
AddLabel(showLabels and !IsNaN(Financials), "Financials " + AsText(Round(Financials, 1)), GlobalColor("Financials"));
AddLabel(showLabels and !IsNaN(InformationTechnology), "Info tech " + AsText(Round(InformationTechnology, 1)), GlobalColor("Tech"));
AddLabel(showLabels and !IsNaN(CommunicationServices), "Comm svcs " + AsText(Round(CommunicationServices, 1)), GlobalColor("CommServices"));
AddLabel(showLabels and !IsNaN(Utilities), "Utilities " + AsText(Round(Utilities, 1)), Color.GREEN);
AddLabel(showLabels and !IsNaN(RealEstate), "Real estate " + AsText(Round(RealEstate, 1)), GlobalColor("RealEstate"));

def lastBar = !IsNaN(close) and IsNaN(close[-1]);

AddChartBubble(showBubbles and lastBar and !IsNaN(Energy), Energy, "Energy", Color.RED, yes);
AddChartBubble(showBubbles and lastBar and !IsNaN(Materials), Materials, "Materials", GlobalColor("Materials"), yes);
AddChartBubble(showBubbles and lastBar and !IsNaN(Industrials), Industrials, "Industrials", GlobalColor("Industrials"), yes);
AddChartBubble(showBubbles and lastBar and !IsNaN(ConsumerDiscretionary), ConsumerDiscretionary, "Cons Disc", GlobalColor("ConsumerDisc"), yes);
AddChartBubble(showBubbles and lastBar and !IsNaN(ConsumerStaples), ConsumerStaples, "Cons Staples", GlobalColor("ConsumerStaples"), yes);
AddChartBubble(showBubbles and lastBar and !IsNaN(HealthCare), HealthCare, "Health Care", GlobalColor("HealthCare"), yes);
AddChartBubble(showBubbles and lastBar and !IsNaN(Financials), Financials, "Financials", GlobalColor("Financials"), yes);
AddChartBubble(showBubbles and lastBar and !IsNaN(InformationTechnology), InformationTechnology, "Info Tech", GlobalColor("Tech"), yes);
AddChartBubble(showBubbles and lastBar and !IsNaN(CommunicationServices), CommunicationServices, "Comm Svcs", GlobalColor("CommServices"), yes);
AddChartBubble(showBubbles and lastBar and !IsNaN(Utilities), Utilities, "Utilities", Color.GREEN, yes);
AddChartBubble(showBubbles and lastBar and !IsNaN(RealEstate), RealEstate, "Real Estate", GlobalColor("RealEstate"), yes);
