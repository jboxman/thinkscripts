# SPX Drawdown Frequency
#
# Daily-chart study with two separate measurements:
#   - Circles mark bearish bars whose high-to-low range is at least
#     minorDrawdownPercent.
#   - The label counts closing-price swings of at least majorCorrectionPercent.
#
# OHLC data does not reveal whether the high occurred before the low. A minor
# event therefore means range, not known intrabar sequence. ZigZag moves its
# newest major swing as price extends, so the current count can repaint.
# Counts cover only loaded, closed daily bars.

declare upper;
declare hide_on_intraday;

input referenceSymbol = "SPX";
input minorDrawdownPercent = 1.0;
input majorCorrectionPercent = 5.0;
input showMinorDeclineCircles = yes;
input showCountLabels = yes;
input onlyClosedBars = yes;

Assert(minorDrawdownPercent > 0 and minorDrawdownPercent < 100,
       "minorDrawdownPercent must be greater than zero and less than 100");
Assert(majorCorrectionPercent > minorDrawdownPercent and
       majorCorrectionPercent < 100,
       "majorCorrectionPercent must exceed minorDrawdownPercent and be less than 100");

DefineGlobalColor("MinorDecline", CreateColor(255, 190, 70));
DefineGlobalColor("MajorPeak", CreateColor(255, 95, 95));

def isDaily = GetAggregationPeriod() == AggregationPeriod.DAY;
def spxOpen = open(symbol = referenceSymbol);
def spxHigh = high(symbol = referenceSymbol);
def spxLow = low(symbol = referenceSymbol);
def spxClose = close(symbol = referenceSymbol);
def validReferenceBar =
    !IsNaN(spxOpen) and !IsNaN(spxHigh) and
    !IsNaN(spxLow) and !IsNaN(spxClose) and spxHigh > 0;
def closedBarOK = if !onlyClosedBars or !IsNaN(spxClose[-1]) then 1 else 0;
def eligibleBar =
    if isDaily and validReferenceBar and closedBarOK == 1 then 1 else 0;

def barDrawdownPercent =
    if eligibleBar == 1
    then 100 * (spxHigh - spxLow) / spxHigh
    else 0;
def minorDeclineEvent =
    if eligibleBar == 0 then 0
    else if spxClose < spxOpen and
            barDrawdownPercent >= minorDrawdownPercent
        then 1
    else 0;

# Passing the close as both inputs makes correction depth close-to-close.
# percentage reversal uses a decimal fraction: 5% = 0.05.
def majorSwingHigh = ZigZagHighLow(
    "price h" = spxClose,
    "price l" = spxClose,
    "percentage reversal" = majorCorrectionPercent / 100,
    "absolute reversal" = 0,
    "atr length" = 5,
    "atr reversal" = 0
).lastH;

def majorPeakEvent =
    if eligibleBar == 1 and !IsNaN(majorSwingHigh) then 1 else 0;

plot MinorDeclineCircle =
    if showMinorDeclineCircles and minorDeclineEvent
    then high + Max(2 * TickSize(), (high - low) * 0.08)
    else Double.NaN;
MinorDeclineCircle.SetPaintingStrategy(PaintingStrategy.POINTS);
MinorDeclineCircle.SetDefaultColor(GlobalColor("MinorDecline"));
MinorDeclineCircle.SetLineWeight(3);
MinorDeclineCircle.HideBubble();
MinorDeclineCircle.HideTitle();

def loadedSessionCount = CompoundValue(1,
    loadedSessionCount[1] + eligibleBar,
    eligibleBar);
def minorDeclineCount = CompoundValue(1,
    minorDeclineCount[1] + minorDeclineEvent,
    minorDeclineEvent);
# Each confirmed peak represents one decline that reached the major threshold.
def majorCorrectionCount = CompoundValue(1,
    majorCorrectionCount[1] + majorPeakEvent,
    majorPeakEvent);
def minorDeclineRate =
    if loadedSessionCount > 0
    then 100 * minorDeclineCount / loadedSessionCount
    else 0;
def sessionsPerMajorCorrection =
    if majorCorrectionCount > 0
    then loadedSessionCount / majorCorrectionCount
    else 0;

AddLabel(
    showCountLabels and isDaily,
    referenceSymbol + " " + minorDrawdownPercent + "%+ bearish high-low bars: " +
        minorDeclineCount + " / " + loadedSessionCount + " (" +
        Round(minorDeclineRate, 1) + "%)",
    GlobalColor("MinorDecline")
);

AddLabel(
    showCountLabels and isDaily,
    referenceSymbol + " " + majorCorrectionPercent + "%+ corrections: " +
        majorCorrectionCount +
        (if majorCorrectionCount > 0
         then " (~1 per " + Round(sessionsPerMajorCorrection, 0) + " sessions)"
         else ""),
    GlobalColor("MajorPeak")
);

AddLabel(
    !isDaily,
    "SPX Drawdown Frequency requires a daily chart",
    GlobalColor("MajorPeak")
);

AddLabel(
    IsNaN(spxClose),
    "No data for reference symbol " + referenceSymbol,
    GlobalColor("MajorPeak")
);
